# Copy to .env.local for development or .env.production for desktop packaging.
# These values may be bundled into the app. Do not put signing or provider secrets here.
# Optional, development only. Default: 3001. Change if that port is in use.
# FRONTEND_PORT=3002

# Used only during development.
# Packaged desktop apps do not trust `.env`; they use runtime_config.json generated at build time.
BACKEND_URL=<http://127.0.0.1:<backend-port>>

# API host for the Vite renderer (fixed).
# - Packaged desktop builds embed this host in runtime_config.json and allow it through CSP connect-src.
# - Must match the origin of `BACKEND_URL`.
VITE_API_HOST=<http://127.0.0.1:<backend-port>>

# Electron WebSocket heartbeat (optional).
WS_HEARTBEAT_INTERVAL_MS=<websocket-heartbeat-interval-ms>
WS_HEARTBEAT_TIMEOUT_MS=<websocket-heartbeat-timeout-ms>

VITE_SUPABASE_URL=<https://your-project.supabase.co>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# Web app URL used by Electron to open an external browser and start sign-in (required).
VITE_WEB_APP_URL=<https://your-frontend.web.app>

# Local-only salt for stable log fingerprints (recommended).
# - Used to correlate user_id, storage_path, and similar values in logs without exposing their raw contents.
PANTARAY_LOG_SALT=<local-dev-only-random-salt>

# Log level (optional).
# - debug | info | warn | error | silent
PANTARAY_LOG_LEVEL=<debug|info|warn|error|silent>
