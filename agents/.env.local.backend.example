# Copy to .env.local.backend.local for development or .env.local.backend.production for packaging.
# Example source environment for generating the packaged local backend runtime bundle.
# Do not put provider secrets in this file.
# Electron loads the bundle generated from this source and fills in machine-specific paths at startup.

# --- Basic runtime ---
# Local backend runtime mode: development, production, or test.
# Release builds automatically set this to production when generating the bundle; no manual override is needed.
NODE_ENV=<node_env>
# Whether to use mock repositories and clients.
USE_MOCKS=<true or false>
# Backend log level (this value applies only in development).
# Release builds automatically set this to ERROR when generating the bundle; no manual override is needed.
LOG_LEVEL=<log_level>
# NOTE: Do not set LOG_FILE_PATH in this source environment.
# Electron supplies a path under app.getPath('logs') at startup.
# Comma-separated CORS origins allowed by the backend.
ALLOWED_ORIGINS=<allowed_origins>
# Comma-separated Host header values allowed by the backend.
ALLOWED_HOSTS=<allowed_hosts>

# --- Local DB / artifact policy ---
# SQLite busy timeout in milliseconds.
LOCAL_DB_BUSY_TIMEOUT_MS=<local_db_busy_timeout_ms>

# --- Cloud proxy ---
# Local API authentication uses a token issued by the runtime on each startup,
# so this source environment does not need Supabase settings.
# Cloud proxy endpoint for LLM inference.
LLM_PROXY_URL=<llm_proxy_url>
# Cloud proxy endpoint for web search.
WEB_TOOLS_PROXY_URL=<web_tools_proxy_url>
