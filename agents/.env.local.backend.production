# Desktop packaging input, checked in: every value here is public and ships in the app.
# Keep secrets out. The build forces NODE_ENV=production and LOG_LEVEL=ERROR, and adds the
# Cloud proxy URLs (see .env.local.backend.example) only while account login is enabled.
USE_MOCKS=false
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ALLOWED_HOSTS=localhost,127.0.0.1
LOCAL_DB_BUSY_TIMEOUT_MS=5000
